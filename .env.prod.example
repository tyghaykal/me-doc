# Copy to .env.prod and fill in real values. Used by:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# Do not reuse .env (that's the dev file docker-compose.yml/.override.yml read,
# full of throwaway defaults like `medoc`/`minioadmin`).

# --- Branding (white-label) ---
PRODUCT_NAME=MeDoc

# --- Postgres ---
POSTGRES_USER=medoc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=medoc

# --- Object storage (S3-compatible — Cloudflare R2, DigitalOcean Spaces, ...) ---
# Cloudflare R2:      S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com, S3_REGION=auto
# DigitalOcean Spaces: S3_ENDPOINT=https://<region>.digitaloceanspaces.com,      S3_REGION=<region> (e.g. nyc3)
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=medoc
S3_BUCKET_BACKUP=medoc-backup
# Leave unset to default to S3_ENDPOINT — only set this if the browser must
# reach storage through a different host than the backend does (e.g. a CDN
# domain in front of the bucket).
S3_PUBLIC_ENDPOINT=

# --- Database backup (db-backup service) ---
BACKUP_CRON_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=30

# --- SMTP (real relay — SES, Postmark, Mailgun, your own server, ...) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=no-reply@yourdomain.com

# --- Backend ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600
OTP_TTL_SECONDS=600
# 32 raw bytes, base64. Seals each user's BYOK AI provider key at rest.
# Generate with: openssl rand -base64 32
AI_ENCRYPTION_KEY=
RUST_LOG=info
# Public https origin users hit — same value nginx/conf.d/default.conf's
# server_name should match, and what Google OAuth's redirect URI is under.
FRONTEND_ORIGIN=https://yourdomain.com

# --- Google OAuth (leave blank to disable Google sign-in) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/google/callback

# --- nginx host ports ---
NGINX_HTTP_HOST_PORT=80
NGINX_HTTPS_HOST_PORT=443
