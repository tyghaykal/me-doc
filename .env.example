# Copy to .env and adjust as needed for local dev.

# --- Branding (white-label) ---
PRODUCT_NAME=MeDoc

# --- Postgres ---
POSTGRES_USER=medoc
POSTGRES_PASSWORD=medoc
POSTGRES_DB=medoc
DATABASE_URL=postgres://medoc:medoc@postgres:5432/medoc

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- MinIO (S3-compatible, dev only) ---
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=medoc
S3_BUCKET_BACKUP=medoc-backup
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# --- Database backup (db-backup service) ---
BACKUP_CRON_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=30

# --- Mailpit (dev SMTP) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@me-doc.local

# --- Backend ---
BACKEND_PORT=8080
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600
OTP_TTL_SECONDS=600
# 32 raw bytes, base64. Seals each user's BYOK AI provider key at rest.
AI_ENCRYPTION_KEY=jggvRPSC2kRrpLHKxGtQyiqGvOzkgI1FJS8J1H9cnp4=
RUST_LOG=info
FRONTEND_ORIGIN=http://localhost:3000

# --- Google OAuth (leave blank to disable Google sign-in) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be registered as an authorized redirect URI on the Google OAuth client,
# e.g. https://localhost/auth/google/callback
GOOGLE_REDIRECT_URI=https://localhost/auth/google/callback

# --- Frontend ---
NUXT_PUBLIC_API_BASE=http://localhost:8080

# --- Host port overrides (only affects host machine access, not container-to-container traffic) ---
# Defaults are chosen to avoid clashing with common local dev stacks; override if you still hit conflicts.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6380
MINIO_API_HOST_PORT=9010
MINIO_CONSOLE_HOST_PORT=9011
MAILPIT_SMTP_HOST_PORT=1125
MAILPIT_UI_HOST_PORT=8125
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000
